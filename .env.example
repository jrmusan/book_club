# Neon (pulled by `neon deploy` / `neon env pull`)
# DATABASE_URL          — pooled (-pooler) for the app
# DATABASE_URL_UNPOOLED — direct, for prisma migrate
# Local Docker alternative: set both to the same localhost URL.
DATABASE_URL="postgresql://bookclub:bookclub@localhost:5432/bookclub?schema=public"
DATABASE_URL_UNPOOLED="postgresql://bookclub:bookclub@localhost:5432/bookclub?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional
GOOGLE_BOOKS_API_KEY=""
