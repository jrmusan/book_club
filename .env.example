# Local: plain URL is fine. Production (Render free Postgres): the app adds
# connection_limit=5 automatically if missing. You can also set it explicitly:
# DATABASE_URL="postgresql://...?schema=public&connection_limit=5&pool_timeout=10"
DATABASE_URL="postgresql://bookclub:bookclub@localhost:5432/bookclub?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" when deployed behind a reverse proxy (e.g. Render, Vercel)
AUTH_TRUST_HOST="true"
GOOGLE_BOOKS_API_KEY=""
