# Neon (pulled by `neon deploy` / `neon env pull`)
# DATABASE_URL          — pooled (-pooler) for the app
# DATABASE_URL_UNPOOLED — direct, for prisma migrate
# Local Docker alternative: set both to the same localhost URL.
DATABASE_URL="postgresql://bookclub:bookclub@localhost:5432/bookclub?schema=public"
DATABASE_URL_UNPOOLED="postgresql://bookclub:bookclub@localhost:5432/bookclub?schema=public"

# Resend magic-link sign-in. Checklist: SETUP.md
# Sending-access key from https://resend.com/api-keys. It starts with re_.
RESEND_API_KEY="re_placeholder_replace_me"

# From address on the domain you verified in Resend (the domain is the part after @).
# Display name is optional: Book Club <login@yourdomain.com>
# Until that domain verifies, mail from onboarding@resend.dev is delivered only to
# the inbox that owns the Resend account.
RESEND_FROM_EMAIL="Book Club <login@yourdomain.com>"

# Auth.js session cookie
# openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public origin. Magic links are built from this (no trailing slash).
# Local: http://localhost:3000
# Production: https://your-app.vercel.app or your custom domain.
AUTH_URL="http://localhost:3000"
# Same value as AUTH_URL. Kept so older hosts that still read NEXTAUTH_URL keep working.
NEXTAUTH_URL="http://localhost:3000"

# Trust the Host header when the platform terminates TLS (Vercel, Render).
AUTH_TRUST_HOST="true"

# Session cookie lifetime in seconds. Code defaults to 2592000 (30 days) if this is unset or invalid.
# The cookie is httpOnly, SameSite=Lax, and Path=/.
# When AUTH_URL is https the cookie is Secure and named __Secure-authjs.session-token.
# On local http it is named authjs.session-token.
AUTH_SESSION_MAX_AGE="2592000"

# Optional
GOOGLE_BOOKS_API_KEY=""
